# Ignore heavy assets, envs, model weights, cloned agents

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.venv-*/
.env
build/
!engine_adapters/godot/build/
!engine_adapters/godot/build/*.py
# Eigen, checked out by o-voxel's setup.py rather than vendored.
models/gen_3d_object/trellis_utils/trellis_2_utils/o-voxel/third_party/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Models / assets (leave placeholders only)
.models/
*.ckpt
*.safetensors
*.bin
*.pth

# Heavy media (allow the small reference samples in the benchmark test set)
*.mp4
*.mov
*.fbx
*.glb
*.obj
!test_data/test_samples/**/ref_*/**
!test_data/test_samples/**/source_motions/**
!test_data/test_samples/**/target_skeletons/**
!assets/**

# Generated artifacts — keep the per-game skeleton and the README, ignore contents
test_data/outputs/**
!test_data/outputs/README.md
!test_data/outputs/**/
!test_data/outputs/**/.gitkeep

# Godot editor/import cache
.godot/

# Cloned code agents
third_party/*/
!third_party/README.md
!third_party/.gitkeep

_cache_code/

# tmp
.tmp/

# agent
.codex/
