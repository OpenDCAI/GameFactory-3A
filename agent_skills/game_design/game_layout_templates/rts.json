      {"id": "construct", "name": "Heavy construct", "category": "Construct", "discovery": "known", "model": "construct", "base_stats": {"HP": "400", "Footprint": "4 cells"}, "traits": ["Non-humanoid framing", "Prototype model is not available"], "source": "Layout fixture"},
      {"id": "unknown", "name": "Undiscovered entity", "category": "Unknown", "discovery": "unknown", "model": null, "source": "Layout fixture"}
    ],
    "equipment": [
      {"id": "blade", "name": "Training blade", "category": "Weapon", "discovery": "known", "slot": "Platform", "model": "sword", "stats": {"Power": 12, "Weight": 3}, "units": {"Power": "fixture points", "Weight": "kg"}, "effects": ["Sample melee platform"], "compatibility": "Platform slot", "source": "Layout fixture"},
      {"id": "staff", "name": "Practice staff", "category": "Weapon", "discovery": "known", "slot": "Platform", "model": "staff", "stats": {"Power": 8, "Weight": 2}, "units": {"Power": "fixture points", "Weight": "kg"}, "effects": ["Sample channeling platform"], "compatibility": "Platform slot", "source": "Layout fixture"},
      {"id": "shield", "name": "Guard plate", "category": "Armor", "discovery": "locked", "slot": "Armor", "model": "shield", "stats": {"Defense": 5}, "units": {"Defense": "fixture points"}, "effects": ["Not compatible with platform comparison"], "compatibility": "Armor slot required", "source": "Layout fixture"},
      {"id": "companion", "name": "Companion token", "category": "Companion", "discovery": "known", "slot": "Companion", "model": null, "stats": {}, "effects": ["An equipment slot, not a recruitable unit"], "compatibility": "Compatible owner required", "source": "Layout fixture"}
    ]
  }
}
