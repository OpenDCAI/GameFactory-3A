{
  "schema_version": "gamefactory3a.genre_layout.v2",
  "canvas": {"width": 1600, "height": 900, "units": "percent"},
  "genre": "rts",
  "name": "Real-time strategy",
  "design_intent": "An isometric battlefield with persistent economy information and a compact, dense command dock.",
  "palette": {
    "ground": "#566542", "ground_light": "#687951", "ground_dark": "#3D503C",
    "path": "#8C805C", "water": "#4D7274", "tree": "#263D31", "tree_light": "#405C3B",
    "stone": "#8E9285", "stone_light": "#B6B7A4", "stone_dark": "#535E57",
    "roof": "#334F6C", "roof_light": "#52799B", "unit": "#7392B5",
